[colors]
bg = #504945
fg = #ebdbb2
bg2 = #504945
palemagenta = #648c11
primary = #ffb52a
secondary = #e60053
alert = #FF0000
gray = #928374
red = #e57474
;green = #98971a
green = #8ccf7e
yellow = #d79921
blue = #67b0e8
magenta = #c47fd5
cyan = #6cbfbf
purple = #b16286
purple2 = #d3869b
orange = #fe8019
nord-bg = #4c566a
white = #dadada
alt-black = #232a2d

[bar/example]
monitor = ${env:MONITOR:}
width = 100%
height = 24pt
radius = 2
fixed-center = true
top = yes
bottom = no
override-redirect = false

foreground = ${colors.fg}
background = ${colors.bg}

; Under-/overline pixel size and argb color
; Individual values can be defined using:
;   {overline,underline}-size
;   {overline,underline}-color

line-size = 3
line-color = #ebdbb2

border-size = 0px
border-color = #0027A1B9

padding-left = 0
padding-right = 0

module-margin = 0

font-0 = "Iosevka:pixelsize=14;3"
font-1 = "Weather Icons:style=Regular:size=12;6"
;font-2 = "Siji:pixelsize=10;3"
font-2 = "Symbols Nerd Font Mono:size=12;2"
;font-3 = "FontAwesome5Free:style=Solid:pixelsize=10;3"
;font-4 = "FontAwesome5Brands:style=Solid:pixelsize=10;3"

; modules set up
modules-left = i3 sp2 sp2 sp2 sp2 xwindow
modules-center = player-mpris-tail tray 
modules-right = sp1 cpu sp1 eth sp1 updates sp1 pulseaudio sp1 date time usertext

;tray-position = right
;tray-padding = 2
;tray-detached = false
;tray-maxsize = 12
;tray-scale = 1
;tray-background = ${colors.magenta}
;tray-foreground = ${colors.bg}
;tray-offset-x = 0
;tray-offset-y = 0

wm-restack = i3
scroll-up = #i3.next
scroll-down = #i3.prev
cursor-click = pointer

[module/tray]
type = internal/tray
tray-spacing = 0px
tray-size = 60%
tray-padding = 6px
format-margin = 1

[module/powermenu]
type = custom/menu
expand-right = true
format-spacing = 1
label-open = %{F0198C5}%{T2}%{T-}%{F-}
label-close = %{F0198C5}%{T2}%{T-}%{F-}
label-separator = " "
label-separator-foreground = ${colors.foreground}
menu-0-0 = %{FA54242}%{T2}%{T-}%{F-}
menu-0-0-exec = menu-open-1
menu-0-1 =  %{FA54242}%{T2}%{T-}%{F-}
menu-0-1-exec = menu-open-2
menu-0-2 = %{FA54242}%{T2}%{T-}%{F-}
menu-0-2-exec = menu-open-3
menu-1-0 = "Cancel"
menu-1-0-exec = menu-open-0
menu-1-0-foreground = ${colors.foreground}
menu-1-1 = "Reboot"
menu-1-1-exec = systemctl reboot
menu-1-1-foreground = ${colors.alert}
menu-2-1 = "Power Off"
menu-2-1-exec = systemctl poweroff
menu-2-1-foreground = ${colors.alert}
menu-2-0 = "Cancel"
menu-2-0-exec = menu-open-0
menu-2-0-foreground = ${colors.foreground}
menu-3-0 = "Cancel"
menu-3-0-exec = menu-open-0
menu-3-0-foreground = ${colors.foreground}
menu-3-1 = "Logout"
menu-3-1-exec = i3-msg exit
menu-3-1-foreground = ${colors.alert}

[module/sp1]
type = custom/text
;content = ""
format-font = 1
content = "  "
content-foreground = ${colors.yellow}
content-background = ${colors.bg}


[module/sp2]
type = custom/text
;content = ""
content = "  "

[module/usertext]
type = custom/text
format-font = 1
content = " 󰗀 "
content-foreground = ${colors.white}
content-background = ${colors.red}

[module/date]
type = internal/date
interval = 1
date = "%Y-%m-%d"
format-prefix-font = 1
format-prefix = 
format-prefix-foreground = ${colors.blue}
format-prefix-background = ${colors.bg}
label = %date%
label-foreground = ${colors.fg}
label-background = ${colors.bg}
format-prefix-padding = 0.5
label-padding-right = 0.5
label-padding-left = 1

[module/time]
type = internal/date
interval = 1
format-prefix-font = 1
format-prefix = 
time = "%H:%M"
format-prefix-foreground = ${colors.green}
format-prefix-background = ${colors.bg}
label = %time%
label-foreground = ${colors.fg}
label-background = ${colors.bg}
format-prefix-padding = 1
label-padding-right = 1.5

[module/pulseaudio]
type = internal/pulseaudio
format-volume-background = ${colors.bg}
format-volume = <ramp-volume><label-volume>
label-volume = %percentage%%
use-ui-max = false
click-right = pavucontrol
format-volume-padding = 0.5

label-muted = %percentage%%    
;label-muted-foreground = ${colors.blue}
format-muted = <label-muted>
;format-muted-prefix = " "
format-muted-prefix = "󰝟 "
format-muted-prefix-font = 2
format-muted-padding = 0.5
format-muted-foreground = ${colors.gray}
;format-muted-background = ${colors.yellow}

; Ramp settings using <ramp-volume> used for Pulseaudio
ramp-volume-0 = "󰕿 %{F#53E8D4}"
ramp-volume-1 = "󰕿 %{F#53E8D4}"
ramp-volume-2 = "󰕿 %{F#53E8D4}"
ramp-volume-3 = "󰖀 %{F#53E8D4}"
ramp-volume-4 = "󰖀 %{F#53E8D4}"
ramp-volume-5 = "󰖀 %{F#FFFDBB}"
ramp-volume-6 = "󰖀 %{F#FFFDBB}"
ramp-volume-7 = "󰕾 %{F#FFFDBB}"
ramp-volume-8 = "󰕾 %{F#FFF16A}"
ramp-volume-9 = "󰕾 %{F#FFF16A}"
ramp-volume-font = 2

[module/i3]
type = internal/i3
format = <label-state> <label-mode>
index-sort = true
wrapping-scroll = false
strip-wsnumbers = false
enable-click = true
enable-scroll = false

label-mode = %mode%
label-mode-padding = 1
label-mode-foreground = ${colors.fg}
label-mode-background = ${colors.bg}

; focused = Active workspace on focused monitor
label-focused = %index%
label-focused-foreground = ${colors.fg}
label-focused-background = ${colors.orange}
;label-focused-underline = ${colors.bg}
label-focused-padding = 1

; unfocused = Inactive workspace on any monitor
label-unfocused = %index%
label-unfocused-padding = ${self.label-focused-padding}
label-unfocused-foreground = ${colors.fg}
label-unfocused-background = ${colors.bg}

; visible = Active workspace on unfocused monitor
label-visible = %index%
label-visible-foreground = ${self.label-focused-bg}
label-visible-background = ${self.label-focused-fg}
label-visible-underline = ${self.label-focused-underline}
label-visible-padding = ${self.label-focused-padding}

; urgent = Workspace with urgency hint set
label-urgent = %index%
label-urgent-foreground = ${colors.fg}
label-urgent-background = ${colors.alert}
label-urgent-padding = 1

; Separator in between workspaces
label-separator =
label-separator-padding = 0
label-separator-foreground = #fff

[module/xwindow]
type = internal/xwindow
label = %title:0:80:...%
label-foreground = ${colors.white}
label-padding = 1
label-font = 0

[module/cpu]
type = internal/cpu
interval = 2
format-font = 1
format-prefix = " "
format-padding = 0.5
format-prefix-foreground = ${colors.orange}
label = %percentage%%

[module/linux-ver]
type = custom/script
exec = uname -r
interval = 600

[module/updates]
type = custom/script
exec = ~/.config/polybar/scripts/arch_updates.sh
interval = 60
label = %output%
label-padding = 0.5

[network-base]
type = internal/network
interval = 5
format-connected = <label-connected>
format-disconnected = <label-disconnected>
label-disconnected = %{F#F0C674}%ifname%%{F#707880} disconnected

[module/wlan]
inherit = network-base
interface-type = wired
label-connected = %{F#F0C674}%ifname%%{F-} %essid% %local_ip%

;rofi -show power-menu -modi power-menu:rofi-power-menu

[module/eth]
inherit = network-base
interface-type = wired
label-connected = "%{F#53E8D4}󰕒 %{F-}%downspeed:2% %{F#FF9535}󰇚 %{F-}%upspeed:2%"
speed-unit = b/s
ping-intervel = 1
format-connected = <label-connected>
;format-connected-prefix = "󰓅  "
format-connected-prefix-font = 1
format-connected-padding = 0.5
format-disconnected = <label-disconnected>
format-disconnected-prefix = "󰈂 "
format-disconnected-prefix-font = 1
format-disconnected-padding = 1

[module/player-mpris-tail]
type = custom/script
exec = ~/polybar-scripts/player-mpris-tail.py -f '{icon} {:artist:t40:{artist}:}{:artist: - :}{:t40:{title}:}'
tail = true
click-left = ~/polybar-scripts/player-mpris-tail.py previous &
click-right = ~/polybar-scripts/player-mpris-tail.py next &
click-middle = ~/polybar-scripts/player-mpris-tail.py play-pause &

[settings]
throttle-output = 5
throttle-output-for = 10
;throttle-input-for = 30
screenchange-reload = true
compositing-background = over
compositing-foreground = over
compositing-overline = over
compositing-border = over

[global/wm]
margin-top = 2
margin-bottom = 2
